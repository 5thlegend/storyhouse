# ============================================================
# Storyhouse — environment configuration
# Copy this file to .env and adjust. NEVER commit your real .env.
# ============================================================

# --- Server ---
PORT=8787
NODE_ENV=development
# Where the SQLite Memory Vault lives (kept out of git).
DATABASE_PATH=./data/storyhouse.db

# --- Open-source AI core (Ollama + Gemma) ---
# The conversational/memory intelligence. Runs locally by default — no cloud, no API bill.
OLLAMA_BASE_URL=http://localhost:11434
# Open-weight model for reasoning, memory extraction, novelty, retrieval synthesis.
AI_MODEL=gemma3:4b
# Open-weight embedding model for semantic memory search.
EMBED_MODEL=nomic-embed-text
# Which AI provider to use: "ollama" (local, open, default) or "mock" (offline fallback, no model needed).
AI_PROVIDER=ollama

# --- Voice (optional adapters; browser Web Speech API is the free default) ---
# ElevenLabs is OPTIONAL and only powers the voice layer. The open-source Gemma model
# remains the core intelligence. Leave blank to use the browser's built-in speech.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# --- Image generation (memory art) ---
# "mock" = local SVG interpretation card (no keys needed).
# "workers-ai" = open-weight Flux.1 [schnell] (Apache-2.0) via Cloudflare Workers AI.
#   The conversational core stays LOCAL; only this image layer calls out, disclosed in-app.
IMAGE_PROVIDER=mock
IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell
# From the Cloudflare dashboard: Account ID, and an API token with the "Workers AI" permission.
CF_ACCOUNT_ID=
CF_API_TOKEN=

# --- Demo mode ---
# When true, the app loads fictional "Margaret" seed data and shows a DEMO banner.
# The public deployment MUST run in demo mode so no real family memories are exposed.
DEMO_MODE=true

# --- Client (Vite) ---
# Base URL the browser uses to reach the API.
VITE_API_BASE=http://localhost:8787
